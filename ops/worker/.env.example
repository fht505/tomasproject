# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Printify API token: printify.com -> Account -> Connections -> Generate API token
PRINTIFY_API_TOKEN=

# Printify shop id for the connected Etsy store.
# Leave blank at first; `node ops.mjs verify` prints it, then paste it here.
PRINTIFY_SHOP_ID=
