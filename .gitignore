# Credentials — never committed, anywhere in the tree.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

node_modules/

__pycache__/
*.pyc

# Design source and print masters: large binaries, and the print masters are
# regenerable from the sources with `node ops.mjs art`.
ops/art/

# Live operational state pulled from Printify. orders.json is redacted before
# it is written (see ledger.mjs), but it and the product/ledger rolls are
# per-shop runtime data, not source — they do not belong in git history.
ops/state/*
!ops/state/README.md
!ops/state/signals.json
!ops/state/lanes.json

# Generated from gen-listings.mjs + config.json. It bakes in the real shop
# name, so it is built locally rather than committed with a placeholder in it.
ops/BATCH-01.listings.json

# Obsidian: the notes are worth versioning, the editor's local UI state is not.
# workspace.json records which panes happen to be open and rewrites itself
# constantly, so tracking it means a dirty working tree every time the vault is
# opened. Shared config — appearance, plugins, graph settings — stays tracked.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache
.trash/

# Deliverable digital files — regenerated from ops/worker/printables/, too big for git
ops/digital/
